{
  "api_version": "tinadec.io/agent-pack/v1alpha1",
  "kind": "AgentPack",
  "metadata": {
    "pack_id": "tinadec.graph.seed-pack",
    "owner": "tinadec",
    "product_id": "tinadec-core",
    "name": "GraphSeedPack",
    "version": "2.1.0",
    "description": "DmaEA 图编排种子包：3 模板 × 3 模式，一个模式对应一个编排档位（free_form / self_dispatch / deterministic）。执行模板自带工作区内置工具面（枚举/读取/检索/只读 git），MCP 作为可选扩展保留。"
  },
  "compatibility": {
    "minimum_core_version": "0.1.0",
    "required_core_capabilities": [
      "agent_pack_lifecycle",
      "versioned_agent_configuration",
      "frozen_agent_version_binding",
      "graph_mode_packs"
    ]
  },
  "resources": {
    "agents": [
      {
        "resource_key": "meeting",
        "slug": "meeting",
        "display_name": "会议智能体",
        "description": "对话身份持有者：理解意图、在声明边或 spawn 白名单内派发执行。",
        "layer": "operation",
        "role": "session_coordinator",
        "capabilities": ["user.respond", "task.dispatch", "agent.create_temporary", "agent.spawn"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你是用户与系统的对话身份。负责理解用户意图、拆解任务，并只按本模式的编排语义派发：声明边目标或 spawn 白名单内的执行者；对用户保持简洁、先结论后依据。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:seed-base"
      },
      {
        "resource_key": "search",
        "slug": "search",
        "display_name": "检索取证智能体",
        "description": "在工作区内检索与取证，只读不改。",
        "layer": "execution",
        "role": "task_executor",
        "capabilities": ["task.dispatch"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": ["ls", "stat", "read_file", "file_search", "git_status", "git_diff", "git_log", "git_branch_list", "mcp_search", "mcp_invoke"],
        "system_prompt": "你负责检索与取证：只读工作区与已接入的信息源，产出带出处的证据；不做任何写操作。工作区根路径与路径契约见运行时注入的工作区段，路径参数请传工作区内的绝对路径。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:seed-base"
      },
      {
        "resource_key": "global_engineering",
        "slug": "global_engineering",
        "display_name": "全域工程执行智能体",
        "description": "在工作区内执行端到端工程修改。",
        "layer": "execution",
        "role": "task_executor",
        "capabilities": ["task.dispatch"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": ["ls", "stat", "read_file", "file_search", "git_status", "git_diff", "git_log", "write_file", "shell", "git_commit", "git_push"],
        "system_prompt": "你负责端到端工程执行：按任务的成功判据修改工作区，写操作前确认影响面，产出处可验证的工件。先枚举与读取确认现状，再动手改；路径参数请传工作区内的绝对路径（工作区根见运行时注入的工作区段）。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:seed-base"
      }
    ],
    "prompt_pipelines": [
      {
        "resource_key": "seed-base",
        "slug": "seed-base",
        "display_name": "Graph seed 基线管线",
        "description": "所有 seed 模板共享的基线提示词管线。",
        "graph": {
          "nodes": [
            { "id": "template", "type": "template", "config": { "content": "DmaEA 图编排基线：按声明拓扑协作，权限只收窄不放宽。" } },
            { "id": "assemble", "type": "assemble" }
          ],
          "edges": [
            { "source": "template", "target": "assemble" }
          ]
        }
      }
    ],
    "modes": [
      {
        "resource_key": "free_director",
        "slug": "free_director",
        "display_name": "自由总监模式（free_form）",
        "description": "单对话节点总监体：无声明边，meeting 在 spawn 白名单（全部执行模板）内自由搭建执行层。",
        "nodes": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "layer": "operation",
            "label": "Meeting",
            "config": { "conversation": true },
            "relationship": {
              "duty": "理解用户目标，自由搭建并指挥执行层完成任务。",
              "inputs_outputs": { "receives": "user goal", "returns": "final answer" },
              "allowed_dispatch_targets": ["search", "global_engineering"],
              "success_criteria": ["目标被满足或明确向用户说明阻塞"],
              "agent_types": ["search", "global_engineering"]
            },
            "position": null
          }
        ],
        "edges": [],
        "bindings": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "duty_description_ref": "graphseed://relationship/meeting",
            "tool_switches": {},
            "envelope": {
              "spawn": { "max_depth": 1, "max_agents_per_run": 8, "max_parallel_workers": 4 }
            },
            "includes_core_reserved": false
          },
          {
            "agent_ref": "agent:search",
            "tool_switches": {},
            "envelope": { "resources": { "read": [""] } },
            "includes_core_reserved": false
          },
          {
            "agent_ref": "agent:global_engineering",
            "tool_switches": {},
            "envelope": { "resources": { "read": [""], "write": [""] } },
            "includes_core_reserved": false
          }
        ],
        "canvas_layout": {}
      },
      {
        "resource_key": "vibe_graph",
        "slug": "vibe_graph",
        "display_name": "Vibe 图模式（self_dispatch）",
        "description": "三节点声明边拓扑：meeting 按边派发 search 与 global_engineering，边携带数据契约。",
        "nodes": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "layer": "operation",
            "label": "Meeting",
            "config": { "conversation": true },
            "relationship": {
              "duty": "理解用户目标，把任务沿声明边派发给执行层并汇总结果。",
              "inputs_outputs": { "receives": "user goal", "returns": "final answer" },
              "allowed_dispatch_targets": ["search", "global_engineering"],
              "success_criteria": ["每个派发任务声明其边数据契约", "目标被满足或明确向用户说明阻塞"],
              "agent_types": []
            },
            "position": null
          },
          {
            "node_key": "search",
            "agent_ref": "agent:search",
            "layer": "execution",
            "label": "Search",
            "config": {},
            "relationship": {
              "duty": "按边契约检索与取证，只读。",
              "inputs_outputs": { "receives": "query + constraints", "returns": "evidence + sources" },
              "allowed_dispatch_targets": [],
              "success_criteria": ["证据带出处且满足边契约字段"],
              "agent_types": []
            },
            "position": null
          },
          {
            "node_key": "global_engineering",
            "agent_ref": "agent:global_engineering",
            "layer": "execution",
            "label": "Engineering",
            "config": {},
            "relationship": {
              "duty": "按边契约执行工程修改并自验。",
              "inputs_outputs": { "receives": "task + success_criteria + scope", "returns": "artifact + verification + risks" },
              "allowed_dispatch_targets": [],
              "success_criteria": ["工件通过验证且风险被显式列出"],
              "agent_types": []
            },
            "position": null
          }
        ],
        "edges": [
          {
            "edge_key": "meeting-to-search",
            "source_node_key": "meeting",
            "target_node_key": "search",
            "condition": { "request": ["query", "constraints"], "response": ["evidence", "sources"] }
          },
          {
            "edge_key": "meeting-to-engineering",
            "source_node_key": "meeting",
            "target_node_key": "global_engineering",
            "condition": { "request": ["task", "success_criteria", "scope"], "response": ["artifact", "verification", "risks"] }
          }
        ],
        "bindings": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "duty_description_ref": "graphseed://relationship/meeting",
            "tool_switches": {},
            "envelope": {
              "spawn": { "max_depth": 1, "max_agents_per_run": 8, "max_parallel_workers": 4 }
            },
            "includes_core_reserved": false
          },
          {
            "node_key": "search",
            "agent_ref": "agent:search",
            "duty_description_ref": "graphseed://relationship/search",
            "tool_switches": {},
            "envelope": {
              "resources": { "read": [""] }
            },
            "includes_core_reserved": false
          },
          {
            "node_key": "global_engineering",
            "agent_ref": "agent:global_engineering",
            "duty_description_ref": "graphseed://relationship/global_engineering",
            "tool_switches": {},
            "envelope": {
              "resources": { "read": [""], "write": [""] }
            },
            "includes_core_reserved": false
          }
        ],
        "canvas_layout": {}
      },
      {
        "resource_key": "fixed_pipeline",
        "slug": "fixed_pipeline",
        "display_name": "固定管线模式（deterministic）",
        "description": "拓扑焊死：与 vibe_graph 同三人同边，但 meeting 的 spawn 权被 binding envelope 收窄，任何 spawn 意图都被拒绝（graph_tier_spawn_denied）。",
        "nodes": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "layer": "operation",
            "label": "Meeting",
            "config": { "conversation": true },
            "relationship": {
              "duty": "理解用户目标，只在声明边内派发，不得要求任何 roster 外类型。",
              "inputs_outputs": { "receives": "user goal", "returns": "final answer" },
              "allowed_dispatch_targets": ["search", "global_engineering"],
              "success_criteria": ["派发仅落在声明边目标上", "目标被满足或明确向用户说明阻塞"],
              "agent_types": ["search", "global_engineering"]
            },
            "position": null
          },
          {
            "node_key": "search",
            "agent_ref": "agent:search",
            "layer": "execution",
            "label": "Search",
            "config": {},
            "relationship": {
              "duty": "按边契约检索与取证，只读。",
              "inputs_outputs": { "receives": "query + constraints", "returns": "evidence + sources" },
              "allowed_dispatch_targets": [],
              "success_criteria": ["证据带出处且满足边契约字段"],
              "agent_types": []
            },
            "position": null
          },
          {
            "node_key": "global_engineering",
            "agent_ref": "agent:global_engineering",
            "layer": "execution",
            "label": "Engineering",
            "config": {},
            "relationship": {
              "duty": "按边契约执行工程修改并自验。",
              "inputs_outputs": { "receives": "task + success_criteria + scope", "returns": "artifact + verification + risks" },
              "allowed_dispatch_targets": [],
              "success_criteria": ["工件通过验证且风险被显式列出"],
              "agent_types": []
            },
            "position": null
          }
        ],
        "edges": [
          {
            "edge_key": "meeting-to-search",
            "source_node_key": "meeting",
            "target_node_key": "search",
            "condition": { "request": ["query", "constraints"], "response": ["evidence", "sources"] }
          },
          {
            "edge_key": "meeting-to-engineering",
            "source_node_key": "meeting",
            "target_node_key": "global_engineering",
            "condition": { "request": ["task", "success_criteria", "scope"], "response": ["artifact", "verification", "risks"] }
          }
        ],
        "bindings": [
          {
            "node_key": "meeting",
            "agent_ref": "agent:meeting",
            "duty_description_ref": "graphseed://relationship/meeting",
            "tool_switches": {},
            "envelope": {
              "capabilities": ["user.respond", "task.dispatch"],
              "spawn": { "max_depth": 0, "max_agents_per_run": 4, "max_parallel_workers": 4 }
            },
            "includes_core_reserved": false
          },
          {
            "node_key": "search",
            "agent_ref": "agent:search",
            "duty_description_ref": "graphseed://relationship/search",
            "tool_switches": {},
            "envelope": {
              "resources": { "read": [""] }
            },
            "includes_core_reserved": false
          },
          {
            "node_key": "global_engineering",
            "agent_ref": "agent:global_engineering",
            "duty_description_ref": "graphseed://relationship/global_engineering",
            "tool_switches": { "write_file": false },
            "envelope": {
              "resources": { "read": [""], "write": [""] }
            },
            "includes_core_reserved": false
          }
        ],
        "canvas_layout": {}
      }
    ]
  },
  "activation": {
    "workspace_defaults": {
      "agent_ref": "agent:meeting",
      "mode_ref": "mode:vibe_graph",
      "prompt_pipeline_ref": "prompt:seed-base"
    }
  }
}
