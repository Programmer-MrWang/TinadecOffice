{
  "name": "@tinadec/desktop",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "node scripts/check-lockfile-natives.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "node scripts/check-lockfile-natives.mjs",
    "test": "vitest run && node --test electron/appConfig.test.cjs electron/layoutStore.test.cjs electron/serviceDiscovery.test.cjs electron/serviceManager.test.cjs electron/terminalManager.test.cjs scripts/viteCacheGuard.test.mjs scripts/runtimeTargets.test.mjs scripts/packageTargets.test.mjs scripts/lockfileNatives.test.mjs",
    "generate:client": "npx -y openapi-typescript@6 ../../TinadecGateway/tests/__snapshots__/openapi.external.json -o src/generated/schema.d.ts",
    "check:drift": "npm run generate:client && git diff --exit-code -- src/generated/",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "typecheck": "vue-tsc --noEmit",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "package:win": "npm run rebuild:native && npm run build && npm run stage:runtime && npm run check:runtime && node scripts/package.mjs",
    "package:portable": "npm run rebuild:native && npm run build && npm run stage:runtime && npm run check:runtime && node scripts/package.mjs portable",
    "verify:package": "node scripts/verify-package-output.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-windows.mjs",
    "smoke:installed": "node scripts/smoke-installed-windows.mjs",
    "dist:win": "npm run package:win",
    "package:linux": "npm run rebuild:native && npm run build && npm run stage:runtime && npm run check:runtime && node scripts/package.mjs",
    "package:mac": "npm run rebuild:native && npm run build && npm run stage:runtime && npm run check:runtime && node scripts/package.mjs"
  },
  "build": {
    "appId": "com.tinadec.office",
    "productName": "TinadecOffice",
    "electronVersion": "43.3.0",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "package.json",
      "electron/**/*",
      "!electron/*.test.cjs",
      "!electron/**/*.test.cjs",
      "dist/**/*",
      "!node_modules/**/*",
      {
        "from": "../../node_modules/node-pty",
        "to": "node_modules/node-pty",
        "filter": [
          "package.json",
          "lib/**/*",
          "prebuilds/**/*",
          "!prebuilds/win32-arm64/**"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/tinadec-large.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TinadecOffice-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "TinadecOffice-${version}-win-x64-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Tinadec",
      "repo": "TinadecOffice"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "TinadecOffice-${version}-osx-arm64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "TinadecOffice",
      "icon": "build/icon.png",
      "artifactName": "TinadecOffice-${version}-linux-x64.AppImage"
    },
    "dmg": {
      "artifactName": "TinadecOffice-${version}-osx-arm64.${ext}",
      "title": "TinadecOffice"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@lucide/vue": "^1.16.0",
    "@material/material-color-utilities": "^0.3.0",
    "@monaco-editor/loader": "^1.7.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dompurify": "^3.4.5",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pinia": "^4.0.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.7.0",
    "simple-icons": "^16.20.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.6.0-rc.10",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@vue/test-utils": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.10.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12",
    "wait-on": "^9.0.3"
  },
  "description": "TinadecOffice desktop workbench: an Electron shell over the Gateway and Core agent runtime.",
  "homepage": "https://github.com/Tinadec/TinadecOffice",
  "author": "Lincube"
}
